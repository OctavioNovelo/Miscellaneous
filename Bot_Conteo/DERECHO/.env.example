# Copia este archivo a .env y completa los valores.

# OBLIGATORIO: id del grupo de votación (termina en @g.us). Sin él el bot no arranca.
VOTACION_GRUPO_ID=

# Opcional: alertas por Telegram. Sin ellos las alertas solo salen en consola.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: ruta al padrón (por defecto ./data/Padron.xlsx)
# EXCEL_PATH=./data/Padron.xlsx

# Opcional: secciones válidas (por defecto A,B,C,D,E,F,G)
# SECCIONES_VALIDAS=A,B,C,D,E,F,G

# Opcional: ruta a un Chrome/Chromium instalado. Úsala si Puppeteer no pudo
# descargar su propio navegador. En kami: /usr/bin/chromium
# CHROME_PATH=/usr/bin/chromium
